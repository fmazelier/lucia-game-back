# Port d'écoute de l'API
PORT=3000

# Fuseau utilisé pour déterminer "le jour courant" côté serveur
TIMEZONE=Europe/Paris

# Origines autorisées pour le front Angular (séparées par des virgules).
# Vide ou absent = toutes les origines autorisées.
CORS_ORIGINS=http://localhost:4200

# Nombre de reverse proxies devant l'app : 0 en local, 1 derrière le nginx de CapRover
TRUST_PROXY=0

# Unique compte de l'application (aucun utilisateur en base)
USER_LOGIN=lucia
USER_PIN=1234

# Secret de signature du JWT : 32 caractères minimum.
# Générer une valeur unique : openssl rand -base64 48
JWT_SECRET=change-me-avec-openssl-rand-base64-48-minimum-32-caracteres

# Durée de vie du token (format ms : 365d, 10y...)
JWT_EXPIRES_IN=365d

# Emplacements persistés (montés en volume dans Docker)
DATABASE_PATH=./data/database.sqlite
PHOTOS_PATH=./data/photos

# Crée les photos et les jours manquants au démarrage
AUTO_SEED=true

# Notifications push (rappel quotidien). Sans ces deux clés, la fonctionnalité est désactivée.
# Générer la paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact exigé par la spec Web Push (mailto: ou https://)
VAPID_SUBJECT=mailto:contact@example.com

# Heure du rappel quotidien, en cron 5 champs, évalué dans TIMEZONE (défaut : 20h00)
REMINDER_CRON=0 20 * * *

